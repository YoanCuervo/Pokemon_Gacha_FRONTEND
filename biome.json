{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noDescendingSpecificity": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/SandboxCard.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noStaticElementInteractions": "off"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
